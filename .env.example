VITE_CARTO_API_KEY=your_carto_api_key_here
FIRMS_MAP_KEY=your_firms_map_key_here  # daftar gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/

# Notifikasi peringatan dini (Web Push)
# Generate kunci: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:email_anda@contoh.com
PUSH_CHECK_INTERVAL_MIN=5

# --- Laporan harian & alarm darurat ---
# PUSH_DAILY_HOUR=7        # jam kirim laporan harian (WITA, default 07:00)
# PUSH_TEST_ALARM=1        # kirim uji alarm darurat sekali saat server mulai (set 0/off setelah uji)
