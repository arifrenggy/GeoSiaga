VITE_CARTO_API_KEY=your_carto_api_key_here
FIRMS_MAP_KEY=your_firms_map_key_here  # daftar gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/

# Notifikasi peringatan dini (Web Push)
# Generate kunci: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:email_anda@contoh.com
PUSH_CHECK_INTERVAL_MIN=5

# --- Laporan harian & alarm darurat ---
# PUSH_DAILY_HOUR=7        # jam kirim laporan harian (WITA, default 07:00)
# PUSH_TEST_ALARM=1        # kirim uji alarm darurat sekali saat server mulai (set 0/off setelah uji)

# --- Mode laporan status (PUSH_STATUS_MODE) ---
# daily  = laporan harian jam tetap (default, jam PUSH_DAILY_HOUR)
# random = laporan status di waktu acak: pertama 3 menit setelah server nyala,
#          lalu berulang acak tiap 45-240 menit. Isi: cuaca + gempa + kualitas udara + status.
# PUSH_STATUS_MODE=random
# PUSH_FIRST_STATUS_MIN=3
# PUSH_STATUS_MIN_MIN=45
# PUSH_STATUS_MAX_MIN=240

# --- Pengulangan bunyi alarm darurat (otomatis, tanpa pengaturan HP) ---
# PUSH_ALARM_REPEAT=4        # ulang bunyi x (0 = matikan)
# PUSH_ALARM_REPEAT_SEC=40   # jarak antar bunyi (detik)

# --- Ambang notifikasi per kejadian ---
# PUSH_RAIN_PROB=60   # peluang hujan (%) untuk notif "bakal hujan"
# PUSH_AIR_BAD=60     # AQI mulai dianggap tidak sehat

# --- Laporan gabungan rutin (mode random) ---
# PUSH_REPORT_EVERY_MIN=60   # kirim laporan gabungan tiap N menit (0 = matikan)
